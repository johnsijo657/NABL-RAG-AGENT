# Database Configuration
APP_DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Security & Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CHAINLIT_AUTH_SECRET=your-chainlit-auth-secret-here

# Active LLM Provider Selection
# Options: "openrouter", "groq", "ollama"
LLM_PROVIDER=openrouter

# Cloud Provider (Gateway / Multi-model)
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_CHAT_MODEL=your-chat-model-identifier
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloud Provider (Low-latency LPU)
GROQ_API_KEY=your-api-key-here
GROQ_CHAT_MODEL=your-chat-model-identifier

# Local / Self-Hosted Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=your-chat-model-identifier
OLLAMA_EMBED_MODEL=your-embed-model-identifier

# RAG & Retrieval Hyperparameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
RERANK_TOP_N=3
RERANK_SCORE_THRESHOLD=-4.0
MAX_CHAT_MESSAGES=10
